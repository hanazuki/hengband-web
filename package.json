{
  "name": "hengband-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build": "pnpm run css:generate && vite build",
    "build:wasm": "bash ./build.sh",
    "build:wasm:ja": "bash ./build.sh ja",
    "build:wasm:en": "bash ./build.sh en",
    "serve": "pnpm run css:generate && concurrently --kill-others --names css,vite \"pnpm run css:watch\" \"vite\"",
    "css:generate": "hcm 'src/**/*.module.css'",
    "css:watch": "hcm 'src/**/*.module.css' --watch",
    "lint": "biome check .",
    "lintfix": "biome check --write .",
    "typecheck": "pnpm run css:generate && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:xtra": "zx misc/build-xtra.ts",
    "bump-version": "zx misc/bump-version.ts",
    "pull-upstream": "zx misc/pull-upstream.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@hanazuki/node-jsonnet": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "happy-css-modules": "^5.0.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "rollup-plugin-license": "^3.7.1",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "zx": "^8.8.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "imports": {
    "#wasm/*": "./wasm/*"
  }
}
